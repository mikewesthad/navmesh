{
  "extends": "./config/tsconfig.base.json",
  "typedocOptions": {
    "out": "docs",
    "name": "NavMesh Packages",
    "readme": "./README.md",
    "entryPoints": ["./packages/navmesh/src/index.ts", "./packages/phaser-navmesh/src/index.ts"]
  },
  "include": ["./packages/navmesh/src/index.ts", "./packages/phaser-navmesh/src/index.ts"],
  "compilerOptions": {
    "target": "ESNext",
    // Resolve navmesh to its source (rather than its built types) so cross-package links work.
    "paths": { "navmesh": ["./packages/navmesh/src/index.ts"] }
  }
}
